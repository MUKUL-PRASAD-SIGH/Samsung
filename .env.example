# Groq API Key -- recommended for this interruptible/full-duplex agent, since Groq's
# LPU inference latency is much lower than routing through OpenRouter (matters for
# the epoch/barge-in responsiveness budget). Takes priority over OPENROUTER_API_KEY
# if both are set.
# GROQ_API_KEY=gsk_your-key-here

# OpenRouter API Key for cloud evaluation / development
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional model selection
# (default: openai/gpt-oss-120b for Groq, qwen/qwen-2.5-7b-instruct for OpenRouter)
# Groq's available models are org/account-specific -- check yours with:
#   curl -s -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
LLM_MODEL_NAME=qwen/qwen-2.5-7b-instruct

# Optional custom base URL
# (default: https://api.groq.com/openai/v1 for Groq, https://openrouter.ai/api/v1 for OpenRouter)
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Set to "1" if using a local vLLM / llama.cpp OpenAI-compatible server instead
# USE_LOCAL_LLM=1
# LLM_BASE_URL=http://localhost:8000/v1

# Whisper ASR (faster-whisper). base.en is the low-latency default (~0.3s per short utterance
# on CPU); small.en is more accurate but ~2.3x slower and ~250MB to download on first use.
# WHISPER_MODEL=base.en
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# Domain vocabulary hint that biases decoding toward your cities/terms (fixes "Goa" -> "go away")
# WHISPER_INITIAL_PROMPT=Travel booking assistant. Cities: Delhi, Mumbai, Goa ...

# After repeated LLM failures the circuit breaker opens; after this many seconds it lets one
# probe request through and closes again if it succeeds (default 15).
# LLM_CIRCUIT_COOLDOWN_S=15

# LLM request deadline in seconds (defaults: Groq 8, OpenRouter 5, local 2). Text replies can take
# ~3.5s on Groq's gpt-oss-120b, so keep this comfortably above that.
# LLM_TIMEOUT_S=8

# On HTTP 429, wait and retry once if the provider says to retry within this many seconds
# (default 3). Longer waits fail fast into the circuit breaker instead of stalling the user.
# LLM_RATE_LIMIT_MAX_WAIT_S=3

# Optional fallback backend (§7.1): once the primary's circuit breaker opens, requests route
# here (a smaller/faster model) instead of a static "please wait" message, until a half-open
# probe closes the primary circuit again. Disabled unless LLM_FALLBACK_MODEL_NAME is set.
# LLM_FALLBACK_MODEL_NAME=llama-3.1-8b-instant
# LLM_FALLBACK_BACKEND_TYPE=groq
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_TIMEOUT_S=4

# Hands-free voice (streaming + barge-in). Speech is detected server-side with Silero VAD.
# VOICE_ENDPOINT_MS=700          # silence that ends an utterance (lower = snappier, may cut pauses)
# VOICE_MIN_SPEECH_MS=128        # sustained speech needed to start an utterance (rejects clicks)
# VOICE_VAD_THRESHOLD=0.5        # speech probability threshold
# VOICE_PARTIAL_INTERVAL_MS=800  # how often a live partial transcript is produced (also the barge-in check cadence)
# VOICE_MAX_UTTERANCE_S=20       # force-endpoint run-on speech

# Vision (camera / screen frames). The agent calls the analyze_frame tool ONLY when a request refers to
# something visible; frames are otherwise just buffered (newest 3, dropped after 15 s).
# Uses OPENROUTER_API_KEY with FREE vision models, tried in order with automatic failover: free models are
# individually rate-limited/congested upstream, so one hardcoded model would be fragile. Free-tier limits
# apply (historically ~20 requests/min and ~50/day without purchased credits) -- verify on your account.
# VISION_BACKEND=openrouter        # or "mock" (deterministic, no network); default: openrouter if a key exists
# VISION_MODELS=dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free   # override the failover order
# VISION_TIMEOUT_S=30
# VISION_MAX_TOKENS=1500           # reasoning models spend part of this thinking; too small => empty answers

# Tier-1 interrupt detector: MiniLM anchor similarity + lexical cues in a logistic model calibrated on a labeled set
# (`python -m agent.fast_path.calibrate`), with a mid-band "did you mean to change that?" question. Default "auto":
# used whenever sentence-transformers is installed (`pip install -e .[embeddings]`, ~90 MB model, ~10 s one-time load,
# warmed at startup), else the keyword heuristic. Force with 1, or 0 for fast eval/test runs. The keyword heuristic
# misses corrections without a trigger word ("sorry, I meant Jaipur").
# INTENT_EMBEDDINGS=auto

# Latency levers. Soft deadline: if the LLM hasn't answered after this many seconds, say "still working" but KEEP
# waiting until LLM_TIMEOUT_S (0 disables). Voice endpointing adapts per utterance (shorter once the transcript has
# stabilised, longer after a dangling "to"/"and"); a tail partial is transcribed ~200 ms into the silence so the
# final transcript can reuse it instead of a second ASR pass.
# LLM_SOFT_DEADLINE_S=2.0
# VOICE_ADAPTIVE_ENDPOINT=1
# VOICE_TAIL_PARTIAL_MS=200
# VOICE_FINAL_REUSE_SLACK_MS=100

# Spoken replies (Phase C). Piper runs locally (CPU, faster than real time): `pip install -e .[tts]` and download a voice:
#   mkdir -p models/piper && cd models/piper && for f in en_US-lessac-medium.onnx en_US-lessac-medium.onnx.json; do
#     curl -sLO https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/lessac/medium/$f; done
# The UI shows a speaker button once the server reports TTS is available; replies are only voiced for sessions that opt in.
# TTS_BACKEND=auto                  # auto (Piper if installed + voice file present) | piper | mock | off
# TTS_VOICE_PATH=models/piper/en_US-lessac-medium.onnx
# VOICE_STOP_ON_SPEECH_START=0      # 1 = stop talking the instant the VAD hears the user (default: duck, then stop on the first real partial)
# VOICE_SPEAKING_VAD_THRESHOLD=0.75 # VAD bar while the agent is talking (echo resistance)

# ---------------------------------------------------------------------------------------------------------------------
# Deployment & security (Phase G) -- see agent/settings.py. Defaults are safe for localhost; set these before exposing.
# AUTH_TOKEN=change-me-long-random   # bearer token for /ws (?token= or Authorization: Bearer), /warmup, /metrics, full /health
# ALLOWED_ORIGINS=https://agent.example.com   # WebSocket origin allow-list ("*" disables the check). Default: same host + localhost
# TRUST_PROXY=0                      # 1 behind Caddy/nginx: take the client IP from X-Forwarded-For (per-IP limits)
# MAX_CONNECTIONS_PER_IP=20
# MAX_SESSIONS=500
# MSG_RATE_PER_S=30
# MSG_BURST=60
# AUDIO_BYTES_PER_S=256000
# AUDIO_BURST_BYTES=1000000
# MAX_TEXT_MESSAGE_BYTES=4000000
# MAX_USER_TEXT_CHARS=8000
# WARMUP_MIN_INTERVAL_S=30           # POST /warmup spends LLM tokens
# LOG_FORMAT=text                    # json for log shippers (the Docker image defaults to json)
# LOG_LEVEL=INFO
# METRICS_ENABLED=1                  # GET /metrics (Prometheus text format)
# INTENT_DEVICE=cpu                  # MiniLM runs on CPU: ~3 ms/sentence and no VRAM
# DOMAIN=agent.example.com           # docker compose --profile https (Caddy)
