# OpenRouter API Key for cloud evaluation / development
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional model selection (default: qwen/qwen-2.5-7b-instruct)
LLM_MODEL_NAME=qwen/qwen-2.5-7b-instruct

# Optional custom base URL (default: https://openrouter.ai/api/v1)
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Set to "1" if using a local vLLM / llama.cpp OpenAI-compatible server instead of OpenRouter
# USE_LOCAL_LLM=1
# LLM_BASE_URL=http://localhost:8000/v1
