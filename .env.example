# Groq API Key -- recommended for this interruptible/full-duplex agent, since Groq's
# LPU inference latency is much lower than routing through OpenRouter (matters for
# the epoch/barge-in responsiveness budget). Takes priority over OPENROUTER_API_KEY
# if both are set.
# GROQ_API_KEY=gsk_your-key-here

# OpenRouter API Key for cloud evaluation / development
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional model selection
# (default: openai/gpt-oss-120b for Groq, qwen/qwen-2.5-7b-instruct for OpenRouter)
# Groq's available models are org/account-specific -- check yours with:
#   curl -s -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
LLM_MODEL_NAME=qwen/qwen-2.5-7b-instruct

# Optional custom base URL
# (default: https://api.groq.com/openai/v1 for Groq, https://openrouter.ai/api/v1 for OpenRouter)
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Set to "1" if using a local vLLM / llama.cpp OpenAI-compatible server instead
# USE_LOCAL_LLM=1
# LLM_BASE_URL=http://localhost:8000/v1

# Whisper ASR (faster-whisper). base.en is the low-latency default (~0.3s per short utterance
# on CPU); small.en is more accurate but ~2.3x slower and ~250MB to download on first use.
# WHISPER_MODEL=base.en
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# Domain vocabulary hint that biases decoding toward your cities/terms (fixes "Goa" -> "go away")
# WHISPER_INITIAL_PROMPT=Travel booking assistant. Cities: Delhi, Mumbai, Goa ...

# After repeated LLM failures the circuit breaker opens; after this many seconds it lets one
# probe request through and closes again if it succeeds (default 15).
# LLM_CIRCUIT_COOLDOWN_S=15

# LLM request deadline in seconds (defaults: Groq 8, OpenRouter 5, local 2). Text replies can take
# ~3.5s on Groq's gpt-oss-120b, so keep this comfortably above that.
# LLM_TIMEOUT_S=8

# On HTTP 429, wait and retry once if the provider says to retry within this many seconds
# (default 3). Longer waits fail fast into the circuit breaker instead of stalling the user.
# LLM_RATE_LIMIT_MAX_WAIT_S=3

# Hands-free voice (streaming + barge-in). Speech is detected server-side with Silero VAD.
# VOICE_ENDPOINT_MS=700          # silence that ends an utterance (lower = snappier, may cut pauses)
# VOICE_MIN_SPEECH_MS=128        # sustained speech needed to start an utterance (rejects clicks)
# VOICE_VAD_THRESHOLD=0.5        # speech probability threshold
# VOICE_PARTIAL_INTERVAL_MS=800  # how often a live partial transcript is produced (also the barge-in check cadence)
# VOICE_MAX_UTTERANCE_S=20       # force-endpoint run-on speech

# Vision (camera / screen frames). The agent calls the analyze_frame tool ONLY when a request refers to
# something visible; frames are otherwise just buffered (newest 3, dropped after 15 s).
# Uses OPENROUTER_API_KEY with FREE vision models, tried in order with automatic failover: free models are
# individually rate-limited/congested upstream, so one hardcoded model would be fragile. Free-tier limits
# apply (historically ~20 requests/min and ~50/day without purchased credits) -- verify on your account.
# VISION_BACKEND=openrouter        # or "mock" (deterministic, no network); default: openrouter if a key exists
# VISION_MODELS=dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free   # override the failover order
# VISION_TIMEOUT_S=30
# VISION_MAX_TOKENS=1500           # reasoning models spend part of this thinking; too small => empty answers
