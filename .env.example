# Groq API Key -- recommended for this interruptible/full-duplex agent, since Groq's
# LPU inference latency is much lower than routing through OpenRouter (matters for
# the epoch/barge-in responsiveness budget). Takes priority over OPENROUTER_API_KEY
# if both are set.
# GROQ_API_KEY=gsk_your-key-here

# OpenRouter API Key for cloud evaluation / development
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional model selection
# (default: openai/gpt-oss-120b for Groq, qwen/qwen-2.5-7b-instruct for OpenRouter)
# Groq's available models are org/account-specific -- check yours with:
#   curl -s -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
LLM_MODEL_NAME=qwen/qwen-2.5-7b-instruct

# Optional custom base URL
# (default: https://api.groq.com/openai/v1 for Groq, https://openrouter.ai/api/v1 for OpenRouter)
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Set to "1" if using a local vLLM / llama.cpp OpenAI-compatible server instead
# USE_LOCAL_LLM=1
# LLM_BASE_URL=http://localhost:8000/v1

# Whisper ASR (faster-whisper). base.en is the low-latency default (~0.3s per short utterance
# on CPU); small.en is more accurate but ~2.3x slower and ~250MB to download on first use.
# WHISPER_MODEL=base.en
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# Domain vocabulary hint that biases decoding toward your cities/terms (fixes "Goa" -> "go away")
# WHISPER_INITIAL_PROMPT=Travel booking assistant. Cities: Delhi, Mumbai, Goa ...
